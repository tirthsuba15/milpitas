# Copy to .env and fill in your key.
VITE_ANTHROPIC_API_KEY=sk-ant-...

# Turn the LLM Commander ON. Default OFF — when unset/not "true", the app runs
# entirely on the deterministic fallback ($0, no API calls). Set to "true" to get
# live Claude narration (requires a key with quota).
VITE_USE_LLM=true

# Optional: session spend cap in USD (best-effort, resets on page reload).
# Defaults to 5 if unset or invalid. Once hit, planning falls back to deterministic.
VITE_LLM_BUDGET_USD=5
